@{
    ViewData["Title"] = "Sign in";
}
<div class="demo-page login-page">
    <div class="demo-card">
        <h1>Sign in</h1>
        <form method="post" asp-action="Login">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input class="form-control" id="email" name="email" type="email" autocomplete="username" value="@(ViewBag.Email ?? "sarah.chen@dotnetreport.demo")" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required autofocus />
                <div class="form-text">Demo password for every user: <code>Demo123!</code></div>
            </div>
            <button class="btn btn-primary w-100" type="submit">Sign in</button>
        </form>
    </div>
</div>
